# /etc/logrotate.d/cybernode — files written by the health check and the ufw helper.
# The node itself logs to journald (see journald-cybernode.conf); nothing of it is rotated here.
/var/log/cybernode/*.log {
    daily
    rotate 30
    missingok
    notifempty
    compress
    delaycompress
    create 0640 cyber adm
}
